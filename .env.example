# ==============================================================================
# BuildBid PH - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your own project credentials.
# NEVER commit the actual '.env' file or private API keys to version control.
# ==============================================================================

# ─── Firebase Configuration ───────────────────────────────────────────────────
# Obtain from: Firebase Console > Project Settings > General > Your apps (Web)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_firebase_app_id

# ─── EmailJS (OTP & Notifications) ───────────────────────────────────────────
# Sign up at https://www.emailjs.com/
# Create an email service and template with variables: {{to_name}}, {{to_email}}, {{otp_code}}
REACT_APP_EMAILJS_SERVICE_ID=your_emailjs_service_id
REACT_APP_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
REACT_APP_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ─── PayMongo Payment Gateway ────────────────────────────────────────────────
# Obtain from: https://dashboard.paymongo.com/ > Developers > API Keys
# Use test keys (pk_test_... / sk_test_...) during development and testing
REACT_APP_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
REACT_APP_PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here

# ─── Archie AI (Claude Construction Assistant) ───────────────────────────────
# Local Dev: Read server-side via setupProxy.js (never exposed in browser bundle)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Production: Supabase Edge Function endpoint for secure server-side invocation
REACT_APP_ARCHIE_URL=https://your_supabase_project_ref.supabase.co/functions/v1/archie-chat

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Obtain from: Supabase Dashboard > Settings > API
REACT_APP_SUPABASE_URL=https://your_supabase_project_ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
